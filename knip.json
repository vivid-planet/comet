{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "workspaces": {
        ".": {
            "entry": ["dev-pm.config.ts"],
            "project": ["*.{js,ts,tsx}"],
            "ignoreDependencies": ["open-cli"],
            "ignoreBinaries": ["oauth2-proxy", "playwright"]
        },
        "codemods": {
            "ignore": ["*"],
            "entry": [],
            "project": []
        },
        "demo/admin": {
            "entry": ["./src/loader.ts", "./src/**/*.dextinityGen.{ts,tsx}"],
            "project": ["./src/**/*.{ts,tsx}"],
            "ignore": ["./src/**/generated/**", "**/graphql.generated.ts", "**/*.generated.ts"],
            "ignoreDependencies": ["@swc/plugin-emotion", "cosmiconfig-toml-loader", "@babel/core"],
            "oxlint": ["oxlint.config.mts"]
        },
        "demo/api": {
            "entry": [
                "./src/main.ts",
                "./src/content-scope/content-scope.interface.ts",
                "./src/repl.ts",
                "./src/db/ormconfig.cli.ts",
                "./src/db/migrations/**/*.ts",
                "./src/auth/user.interface.ts",
                "./src/auth/permission.interface.ts",
                "./src/reload.ts",
                "./src/tracing.dev.ts",
                "./src/tracing.production.ts"
            ],
            "project": ["./src/**/*.{ts,tsx}"],
            "ignoreDependencies": ["@as-integrations/express5", "eslint-plugin-storybook"],
            "ignore": ["./src/**/generated/**", "**/*.generated.ts"],
            "oxlint": ["oxlint.config.mts"]
        },
        "demo/site": {
            "entry": ["./src/app/**", "./cache-handler.ts", "./server.ts", "./opentelemetry-metrics.ts", "tracing.dev.ts", "tracing.production.ts"],
            "project": ["./src/**/*.{ts,tsx}"],
            "ignoreDependencies": ["@babel/core", "@types/grecaptcha"],
            "ignore": ["**/*.generated.ts"],
            "oxlint": ["oxlint.config.mts"]
        },
        "docs": {
            "ignore": ["./docs/**/*.mdx", "./src/components/StorybookAdminComponentDocsIframe.tsx", ".docusaurus/**"],
            "ignoreDependencies": ["@algolia/client-search", "search-insights"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/admin/admin": {
            "project": ["./src/**/*.{ts,tsx}"],
            "ignore": [".storybook/public/mockServiceWorker.js"],
            "ignoreDependencies": ["@mui/x-data-grid-premium", "eslint-plugin-storybook"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/admin/admin-babel-preset": {
            "ignore": ["*"]
        },
        "packages/admin/admin-color-picker": {
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/admin/admin-date-time": {
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/admin/admin-generator": {
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/admin/admin-icons": {
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/admin/admin-rte": {
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/admin/brevo-admin": {
            "project": ["./src/**/*.{ts,tsx}"],
            "ignore": ["**/*.generated.ts"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/admin/cms-admin": {
            "project": ["./src/**/*.{ts,tsx}"],
            "ignore": ["**/*.generated.ts", ".storybook/public/mockServiceWorker.js"],
            "oxlint": ["oxlint.config.mts"],
            "ignoreDependencies": ["eslint-plugin-storybook"]
        },
        "packages/api/api-generator": {
            "entry": ["./src/**/__tests__/**/*.ts"],
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/api/brevo-api": {
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/api/cms-api": {
            "entry": ["./src/**/migrations/*.ts"],
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/cli": {
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/eslint-config": {
            "ignore": ["*"],
            "entry": [],
            "project": [],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/eslint-plugin": {
            "project": ["./src/**/*.{ts,tsx}"],
            "oxlint": ["oxlint.config.mts"],
            "ignoreDependencies": ["eslint-plugin-simple-import-sort", "eslint-plugin-unused-imports"]
        },
        "packages/mail-react": {
            "project": ["./src/**/*.{ts,tsx}"],
            "ignore": ["./src/**/*.generated.ts"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/site/site-nextjs": {
            "project": ["./src/**/*.{ts,tsx}"],
            "ignore": ["./src/**/*.generated.ts"],
            "oxlint": ["oxlint.config.mts"]
        },
        "packages/site/site-react": {
            "project": ["./src/**/*.{ts,tsx}"],
            "ignore": ["./src/**/*.generated.ts"],
            "oxlint": ["oxlint.config.mts"]
        },
        "storybook": {
            "entry": ["./src/**/*.stories.tsx"],
            "project": ["./src/**/*.{ts,tsx}"],
            "ignoreDependencies": ["eslint-plugin-storybook", "ts-dedent"],
            "oxlint": ["oxlint.config.mts"]
        }
    }
}
