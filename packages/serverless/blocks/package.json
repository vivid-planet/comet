{
    "name": "@dextinity/serverless-blocks",
    "version": "10.10.0",
    "private": true,
    "description": "Prototype: Dextinity blocks for Hono on Cloudflare Workers (zod validation) and the admin (the block framework of @dextinity/cms-admin)",
    "repository": {
        "directory": "packages/serverless/blocks",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "sideEffects": false,
    "type": "module",
    "exports": {
        "./client": {
            "types": "./lib/client/index.d.ts",
            "import": "./lib/client/index.js",
            "default": "./lib/client/index.js"
        },
        "./server": {
            "types": "./lib/server/index.d.ts",
            "import": "./lib/server/index.js",
            "default": "./lib/server/index.js"
        }
    },
    "files": [
        "lib/*",
        "!lib/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@dextinity/serverless-core": "workspace:*"
    },
    "devDependencies": {
        "@apollo/client": "^3.14.1",
        "@dextinity/admin": "workspace:*",
        "@dextinity/cms-admin": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^7.3.11",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "final-form": "^4.20.10",
        "graphql": "^16.14.2",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.10",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.14",
        "rimraf": "^6.1.3",
        "typescript": "5.9.3",
        "vitest": "^5.0.5",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@apollo/client": "^3.7.0",
        "@dextinity/admin": "workspace:*",
        "@dextinity/cms-admin": "workspace:*",
        "@mui/material": "^7.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-final-form": "^6.3.1",
        "react-intl": "^7.0.0",
        "zod": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "@apollo/client": {
            "optional": true
        },
        "@dextinity/admin": {
            "optional": true
        },
        "@dextinity/cms-admin": {
            "optional": true
        },
        "@mui/material": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "react-final-form": {
            "optional": true
        },
        "react-intl": {
            "optional": true
        }
    }
}
