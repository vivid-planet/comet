{
    "name": "@dextinity/serverless-core",
    "version": "10.10.0",
    "private": true,
    "description": "Prototype: Shared server, client and dev tooling for Dextinity feature packages on Cloudflare Workers",
    "repository": {
        "directory": "packages/serverless/core",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "sideEffects": false,
    "type": "module",
    "exports": {
        "./client": {
            "types": "./lib/client/index.d.ts",
            "import": "./lib/client/index.js",
            "default": "./lib/client/index.js"
        },
        "./server": {
            "types": "./lib/server/index.d.ts",
            "import": "./lib/server/index.js",
            "default": "./lib/server/index.js"
        },
        "./vite": {
            "types": "./lib/vite/index.d.ts",
            "import": "./lib/vite/index.js",
            "default": "./lib/vite/index.js"
        }
    },
    "files": [
        "lib/*",
        "!lib/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit"
    },
    "dependencies": {
        "@hono/zod-validator": "^0.9.1",
        "jose": "^6.2.12"
    },
    "devDependencies": {
        "@dextinity/admin": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^7.3.11",
        "@tanstack/react-query": "^5.104.5",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "drizzle-orm": "^0.45.4",
        "eslint": "^9.39.5",
        "hono": "^4.13.13",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.10",
        "react": "^19.3.0",
        "rimraf": "^6.1.3",
        "sharp": "^0.35.5",
        "typescript": "5.9.3",
        "vite": "^8.3.5",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "@dextinity/admin": "workspace:*",
        "@mui/material": "^7.0.0",
        "@tanstack/react-query": "^5.0.0",
        "drizzle-orm": "^0.45.0",
        "hono": "^4.13.0",
        "react": "^19.0.0",
        "sharp": "^0.35.0",
        "vite": "^8.0.0",
        "zod": "^4.0.0"
    },
    "peerDependenciesMeta": {
        "@dextinity/admin": {
            "optional": true
        },
        "@mui/material": {
            "optional": true
        },
        "@tanstack/react-query": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "sharp": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    }
}
