{
    "name": "@dextinity/ui",
    "version": "10.10.0",
    "description": "Themeable React UI primitives built on Base UI and CSS Modules",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/ui"
    },
    "license": "BSD-2-Clause",
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./css": {
            "types": "./lib/css.d.ts",
            "default": "./lib/style.css"
        },
        "./themes/dextinity.css": {
            "types": "./lib/css.d.ts",
            "default": "./lib/themes/dextinity.css"
        }
    },
    "imports": {
        "#storybook/*": "./src/storybook/*.tsx"
    },
    "files": [
        "lib/*"
    ],
    "scripts": {
        "build": "pnpm run clean && vite build",
        "build-storybook": "storybook build --disable-telemetry",
        "chromatic": "chromatic",
        "clean": "rimraf lib",
        "dev": "pnpm run clean && vite build --watch",
        "lint": "run-p lint:prettier lint:eslint lint:style lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ .storybook/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier lint:fix:style",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:fix:style": "pnpm run lint:style --fix",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,mts,js,mjs,json,md,yml,yaml}' '{src,.storybook}/**/*.{ts,tsx,css,mdx}'",
        "lint:style": "pnpm exec stylelint 'src/**/*.css'",
        "lint:tsc": "tsc --noEmit",
        "storybook": "storybook dev -p 26648 --no-open --no-version-updates --disable-telemetry",
        "test": "pnpm run test:unit && pnpm run test:storybook",
        "test:storybook": "vitest --run --project storybook --outputFile.junit=./junit-storybook.xml",
        "test:unit": "vitest --run --project unit --maxWorkers=1 --outputFile.junit=./junit-unit.xml",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@base-ui/react": "^1.9.0",
        "@dextinity/eslint-config": "workspace:*",
        "@fontsource-variable/figtree": "^5.3.0",
        "@storybook/addon-a11y": "10.6.2",
        "@storybook/addon-docs": "10.6.2",
        "@storybook/addon-mcp": "10.6.2",
        "@storybook/addon-vitest": "10.6.2",
        "@storybook/react-vite": "10.6.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/browser": "5.0.4",
        "@vitest/browser-playwright": "5.0.4",
        "chromatic": "18.11.0",
        "eslint": "^9.39.5",
        "eslint-plugin-storybook": "^10.6.1",
        "jsdom": "^28.1.0",
        "npm-run-all2": "^9.0.3",
        "playwright": "^1.64.1",
        "postcss": "^8.5.29",
        "prettier": "^3.9.10",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "remark-gfm": "^4.0.1",
        "rimraf": "^6.1.3",
        "rollup": "^4.64.5",
        "rollup-plugin-preserve-directives": "^0.4.0",
        "storybook": "10.6.2",
        "stylelint": "^17.16.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.7",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^5.0.4"
    },
    "peerDependencies": {
        "@base-ui/react": "^1.9.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
