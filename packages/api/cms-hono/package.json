{
    "name": "@dextinity/cms-hono",
    "version": "10.10.0",
    "private": true,
    "description": "Prototype: Dextinity CMS API modules for Hono (runs on Node.js and Cloudflare Workers)",
    "repository": {
        "directory": "packages/api/cms-hono",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./node": {
            "types": "./lib/node.d.ts",
            "import": "./lib/node.js"
        }
    },
    "files": [
        "lib/*",
        "!lib/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261023.1",
        "@dextinity/eslint-config": "workspace:*",
        "@types/mime-db": "^1.43.6",
        "@types/node": "^24.19.2",
        "drizzle-orm": "^0.45.4",
        "eslint": "^9.39.5",
        "hono": "^4.13.13",
        "npm-run-all2": "^9.0.3",
        "postgres": "^3.4.9",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.3",
        "typescript": "5.9.3",
        "zod": "^4.6.7"
    },
    "dependencies": {
        "@hapi/accept": "^6.0.3",
        "@hono/zod-validator": "^0.9.1",
        "exifr": "^7.1.3",
        "image-size": "^2.0.4",
        "jszip": "^3.10.2",
        "mime-db": "^1.54.0",
        "slugify": "^1.6.9"
    },
    "peerDependencies": {
        "drizzle-orm": "^0.45.0",
        "hono": "^4.13.0",
        "zod": "^4.0.0"
    }
}
