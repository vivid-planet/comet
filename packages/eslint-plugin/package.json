{
    "name": "@dextinity/eslint-plugin",
    "version": "10.0.1",
    "description": "A set of lint rules for Dextinity projects, usable with Oxlint and ESLint",
    "license": "BSD-2-Clause",
    "files": [
        "lib"
    ],
    "type": "commonjs",
    "sideEffects": false,
    "main": "lib/index.js",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "pnpm run clean && tsc --project ./tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch",
        "lint": "run-p lint:oxfmt lint:oxlint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:oxfmt",
        "lint:fix:oxfmt": "pnpm exec oxfmt",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:oxfmt": "pnpm exec oxfmt --check",
        "lint:oxlint": "oxlint --max-warnings 0 src/",
        "lint:tsc": "tsc --noEmit",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "devDependencies": {
        "eslint": "^9.39.4",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "npm-run-all2": "^8.0.4",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.8"
    },
    "peerDependencies": {
        "eslint": ">=9",
        "oxlint": ">=1.78.0"
    },
    "peerDependenciesMeta": {
        "eslint": {
            "optional": true
        },
        "oxlint": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
