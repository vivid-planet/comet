{
    "name": "@dextinity/cli",
    "version": "10.0.1",
    "description": "A collection of CLI tools for Dextinity projects",
    "license": "BSD-2-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/cli"
    },
    "bin": {
        "dextinity": "bin/dextinity.js"
    },
    "files": [
        "bin/**/*.js",
        "lib/*"
    ],
    "type": "commonjs",
    "sideEffects": false,
    "main": "lib/index.js",
    "typings": "lib/index.d.ts",
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "tsc --watch",
        "lint": "run-p lint:oxfmt lint:oxlint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:oxfmt",
        "lint:fix:oxfmt": "pnpm exec oxfmt",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:oxfmt": "pnpm exec oxfmt --check",
        "lint:oxlint": "oxlint --max-warnings 0 src/",
        "lint:tsc": "tsc",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "commander": "^9.5.0",
        "js-yaml": "^4.1.1",
        "ts-node": "^10.9.2"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "workspace:*",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.13.3",
        "npm-run-all2": "^8.0.4",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.8"
    },
    "peerDependencies": {
        "oxfmt": ">=0.63.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
