{
    "name": "@dextinity/mail-react",
    "version": "10.0.1",
    "description": "Utilities for building HTML emails with React",
    "license": "BSD-2-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/mail-react"
    },
    "files": [
        "lib/*"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./lib/index.js",
        "./client": "./lib/client/index.js",
        "./server": "./lib/server/index.js",
        "./storybook": "./lib/storybook/index.js"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "pnpm run clean && pnpm run generate-block-types && tsc -p tsconfig.build.json",
        "build-storybook": "storybook build",
        "clean": "rimraf lib 'src/**/*.generated.ts'",
        "dev": "pnpm run clean && pnpm generate-block-types && tsc --watch",
        "generate-block-types": "dextinity generate-block-types",
        "generate-block-types:watch": "chokidar -s \"**/block-meta.json\" -c \"$npm_execpath generate-block-types\"",
        "lint": "pnpm generate-block-types && run-p lint:oxfmt lint:oxlint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:oxfmt",
        "lint:fix:oxfmt": "pnpm exec oxfmt",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:oxfmt": "pnpm exec oxfmt --check",
        "lint:oxlint": "oxlint --max-warnings 0 src/",
        "lint:tsc": "tsc",
        "storybook": "storybook dev -p 6066 --no-open",
        "test": "pnpm run test:unit && pnpm run test:storybook",
        "test:storybook": "vitest --run --project storybook --outputFile.junit=./junit-storybook.xml",
        "test:unit": "vitest --run --project unit --outputFile.junit=./junit-unit.xml",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@faire/mjml-react": "^3.5.4",
        "clsx": "^2.1.1",
        "mjml": "^4.18.0",
        "mjml-browser": "^4.18.0",
        "redraft": "^0.10.2"
    },
    "devDependencies": {
        "@dextinity/cli": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@storybook/addon-docs": "^10.3.5",
        "@storybook/addon-vitest": "10.3.5",
        "@storybook/react-vite": "^10.3.5",
        "@types/mjml": "^4.7.4",
        "@types/mjml-browser": "^4.15.0",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitest/browser": "4.1.8",
        "@vitest/browser-playwright": "4.1.8",
        "chokidar-cli": "^3.0.0",
        "npm-run-all2": "^8.0.4",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "playwright": "^1.62.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "rimraf": "^6.1.2",
        "storybook": "^10.3.5",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vitest": "^4.1.8"
    },
    "peerDependencies": {
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "storybook": ">=10.0.0"
    },
    "peerDependenciesMeta": {
        "storybook": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
