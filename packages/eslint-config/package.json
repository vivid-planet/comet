{
    "name": "@dextinity/eslint-config",
    "version": "10.0.1",
    "description": "A set of Oxlint and ESLint configurations for Dextinity projects",
    "license": "BSD-2-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/eslint-config"
    },
    "type": "module",
    "exports": {
        "./core.js": {
            "import": "./core.js"
        },
        "./future/nestjs.js": {
            "import": "./future/nestjs.js"
        },
        "./future/nextjs.js": {
            "import": "./future/nextjs.js"
        },
        "./future/react.js": {
            "import": "./future/react.js"
        },
        "./nestjs.js": {
            "import": "./nestjs.js"
        },
        "./nextjs.js": {
            "import": "./nextjs.js"
        },
        "./oxlint/core.js": {
            "types": "./oxlint/core.d.ts",
            "import": "./oxlint/core.js"
        },
        "./oxlint/nestjs.js": {
            "types": "./oxlint/nestjs.d.ts",
            "import": "./oxlint/nestjs.js"
        },
        "./oxlint/nextjs.js": {
            "types": "./oxlint/nextjs.d.ts",
            "import": "./oxlint/nextjs.js"
        },
        "./oxlint/react.js": {
            "types": "./oxlint/react.d.ts",
            "import": "./oxlint/react.js"
        },
        "./react.js": {
            "import": "./react.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "lint": "run-p lint:oxfmt lint:oxlint",
        "lint:ci": "pnpm run lint",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:oxfmt",
        "lint:fix:oxfmt": "pnpm exec oxfmt",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:oxfmt": "pnpm exec oxfmt --check",
        "lint:oxlint": "oxlint --max-warnings 0",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run"
    },
    "dependencies": {
        "@calm/eslint-plugin-react-intl": "^1.4.1",
        "@dextinity/eslint-plugin": "workspace:*",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^9.39.5",
        "@graphql-eslint/eslint-plugin": "^4.4.0",
        "@next/eslint-plugin-next": "^16.2.10",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-formatjs": "^5.4.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsonc": "^2.21.1",
        "eslint-plugin-package-json": "^0.91.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^15.15.0",
        "npm-run-all2": "^8.0.4",
        "typescript-eslint": "^8.62.1"
    },
    "devDependencies": {
        "eslint": "^9.39.4",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.8"
    },
    "peerDependencies": {
        "eslint": ">=9",
        "oxlint": ">=1.78.0",
        "prettier": ">=3"
    },
    "peerDependenciesMeta": {
        "eslint": {
            "optional": true
        },
        "next": {
            "optional": true
        },
        "oxlint": {
            "optional": true
        },
        "prettier": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
