{
    "name": "@dextinity/icons",
    "version": "10.10.0",
    "description": "A collection of icons as plain React components",
    "license": "BSD-2-Clause",
    "type": "module",
    "repository": {
        "directory": "packages/icons",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "exports": {
        ".": "./lib/index.js"
    },
    "sideEffects": false,
    "files": [
        "lib/*"
    ],
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "clean": "rimraf lib",
        "dev": "pnpm run clean && tsc -p tsconfig.build.json --watch",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "clsx": "^2.1.1"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "workspace:*",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "jsdom": "^30.1.2",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.10",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "vitest": "^5.0.4"
    },
    "peerDependencies": {
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "engines": {
        "node": ">=24.15.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
