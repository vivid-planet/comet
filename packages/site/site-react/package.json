{
    "name": "@dextinity/site-react",
    "version": "10.0.1",
    "description": "Dextinity Site React package",
    "license": "BSD-2-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/site/site-react"
    },
    "files": [
        "lib/*"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js"
        },
        "./css": "./lib/style.css",
        "./server": {
            "types": "./lib/server.d.ts",
            "import": "./lib/server.js"
        },
        "./webpackPersistedQueriesLoader": "./lib/persistedQueries/webpackPersistedQueriesLoader.js"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "pnpm run clean && pnpm run generate-block-types && vite build",
        "clean": "rimraf lib 'src/**/*.generated.ts'",
        "dev": "pnpm run clean && pnpm generate-block-types && vite build --watch",
        "generate-block-types": "dextinity generate-block-types",
        "generate-block-types:watch": "chokidar -s \"block-meta.json\" -c \"pnpm generate-block-types\"",
        "lint": "pnpm generate-block-types && run-p lint:oxfmt lint:oxlint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:oxfmt",
        "lint:fix:oxfmt": "pnpm exec oxfmt",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:oxfmt": "pnpm exec oxfmt --check",
        "lint:oxlint": "oxlint --max-warnings 0 src/",
        "lint:tsc": "tsc --noEmit",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "jose": "^5.10.0",
        "lodash.isequal": "^4.5.0",
        "scroll-into-view-if-needed": "^2.2.31",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@dextinity/cli": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@types/draft-js": "^0.11.20",
        "@types/lodash.isequal": "^4.5.8",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.7.0",
        "chokidar-cli": "^3.0.0",
        "jsdom": "^28.1.0",
        "npm-run-all2": "^8.0.4",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "rimraf": "^6.1.2",
        "rollup": "^4.44.2",
        "rollup-plugin-preserve-directives": "^0.4.0",
        "sass": "^1.89.2",
        "schema-dts": "^2.0.0",
        "typescript": "^5.9.3",
        "vite": "^7.2.4",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "^4.1.8",
        "webpack": "^5.106.2"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
