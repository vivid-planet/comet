{
    "name": "@dextinity/cms-admin-hono",
    "version": "10.10.0",
    "private": true,
    "description": "Prototype: Dextinity CMS Admin for the Hono API (@dextinity/cms-hono)",
    "repository": {
        "directory": "packages/admin/cms-admin-hono",
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity"
    },
    "license": "BSD-2-Clause",
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "types": "./lib/index.d.ts"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "pnpm run clean && run-p build:babel build:types",
        "build:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib",
        "build:types": "tsc --project ./tsconfig.json --emitDeclarationOnly",
        "clean": "rimraf lib",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "start": "run-p start:babel start:types",
        "start:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib -w",
        "start:types": "tsc --project ./tsconfig.json --emitDeclarationOnly --watch --preserveWatchOutput"
    },
    "dependencies": {
        "@dextinity/admin": "workspace:*",
        "@dextinity/admin-icons": "workspace:*"
    },
    "peerDependencies": {
        "@mui/material": "^7.0.0",
        "@mui/x-data-grid": "^8.0.0",
        "@tanstack/react-query": "^5.0.0",
        "hono": "^4.13.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-final-form": "^6.3.1",
        "react-intl": "^7.0.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@dextinity/admin-babel-preset": "workspace:*",
        "@dextinity/cms-hono": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/material": "^7.3.11",
        "@mui/x-data-grid": "^8.29.5",
        "@tanstack/react-query": "^5.104.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "final-form": "^4.20.10",
        "hono": "^4.13.13",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.10",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.14",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3"
    }
}
