{
    "name": "@dextinity/admin-rte",
    "version": "10.0.1",
    "description": "Dextinity Admin Rich Text Editor component",
    "license": "BSD-2-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/admin/admin-rte"
    },
    "files": [
        "lib"
    ],
    "type": "module",
    "sideEffects": [
        "./lib/core/Rte.js",
        "./lib/core/RteReadOnly.js"
    ],
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "types": "./lib/index.d.ts"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "pnpm run clean && run-p build:babel build:types",
        "build:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib",
        "build:types": "tsc --project ./tsconfig.json --emitDeclarationOnly",
        "clean": "rimraf lib",
        "lint": "run-p lint:oxfmt lint:oxlint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:oxfmt",
        "lint:fix:oxfmt": "pnpm exec oxfmt",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:oxfmt": "pnpm exec oxfmt --check",
        "lint:oxlint": "oxlint --max-warnings 0 src/",
        "lint:tsc": "tsc --noEmit",
        "start": "run-p start:babel start:types",
        "start:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib -w",
        "start:types": "tsc --project ./tsconfig.json --emitDeclarationOnly --watch --preserveWatchOutput",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@dextinity/admin": "workspace:*",
        "@dextinity/admin-icons": "workspace:*",
        "detect-browser": "^5.3.0",
        "draft-js-export-html": "^1.4.1",
        "draft-js-import-html": "^1.4.1",
        "draftjs-conductor": "^3.0.0",
        "immutable": "~3.8.2"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@dextinity/admin-babel-preset": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@mui/material": "^7.3.11",
        "@types/draft-js": "^0.11.20",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "draft-js": "^0.11.7",
        "final-form": "^4.20.10",
        "jsdom": "^28.1.0",
        "npm-run-all2": "^8.0.4",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.11",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.8"
    },
    "peerDependencies": {
        "@mui/material": "^7.0.0",
        "draft-js": "^0.11.4",
        "final-form": "^4.16.1",
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-final-form": "^6.3.1",
        "react-intl": "^5.0.0 || ^6.0.0 || ^7.0.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
