{
    "name": "@dextinity/admin-date-time",
    "version": "10.0.1",
    "description": "Dextinity Admin Date Time component",
    "license": "BSD-2-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/admin/admin-date-time"
    },
    "files": [
        "lib"
    ],
    "type": "module",
    "sideEffects": [
        "./lib/datePicker/DatePicker.js",
        "./lib/dateRangePicker/DateRangePicker.js"
    ],
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "types": "./lib/index.d.ts"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "pnpm run clean && run-p build:babel build:types",
        "build:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib",
        "build:types": "tsc --project ./tsconfig.json --emitDeclarationOnly",
        "clean": "rimraf lib",
        "lint": "run-p lint:oxfmt lint:oxlint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:oxfmt",
        "lint:fix:oxfmt": "pnpm exec oxfmt",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:oxfmt": "pnpm exec oxfmt --check",
        "lint:oxlint": "oxlint --max-warnings 0 src/",
        "lint:tsc": "tsc --noEmit",
        "start": "run-p start:babel start:types",
        "start:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib -w",
        "start:types": "tsc --project ./tsconfig.json --emitDeclarationOnly --watch --preserveWatchOutput"
    },
    "dependencies": {
        "@dextinity/admin": "workspace:*",
        "@dextinity/admin-icons": "workspace:*",
        "@mui/utils": "^7.3.11",
        "date-fns": "^4.4.0",
        "react-date-range": "^2.0.1"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@dextinity/admin-babel-preset": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@mui/material": "^7.3.11",
        "@types/react": "^19.2.15",
        "@types/react-date-range": "^1.4.10",
        "@types/react-dom": "^19.2.3",
        "final-form": "^4.20.10",
        "npm-run-all2": "^8.0.4",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.11",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@mui/material": "^7.0.0",
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-final-form": "^6.3.1",
        "react-intl": "^5.0.0 || ^6.0.0 || ^7.0.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
