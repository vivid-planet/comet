{
    "name": "@dextinity/admin-generator",
    "version": "10.0.1",
    "description": "Dextinity Admin Generator CLI tool",
    "license": "BSD-2-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/admin/admin-generator"
    },
    "bin": {
        "dextinity-admin-generator": "bin/admin-generator.mjs"
    },
    "files": [
        "bin/**/*.mjs",
        "dist/*"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "types": "./dist/index.d.mts"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "lint": "run-p lint:oxfmt lint:oxlint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:oxfmt",
        "lint:fix:oxfmt": "pnpm exec oxfmt",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:oxfmt": "pnpm exec oxfmt --check",
        "lint:oxlint": "oxlint --max-warnings 0 src/",
        "lint:tsc": "tsc",
        "test": "pnpm run test:unit",
        "test:unit": "vitest --run",
        "test:updateSnapshot": "vitest --run --update",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@dextinity/admin": "workspace:*",
        "@dextinity/admin-icons": "workspace:*",
        "@dextinity/cms-admin": "workspace:*",
        "@graphql-tools/graphql-file-loader": "^7.5.17",
        "@graphql-tools/load": "^7.8.14",
        "@mui/material": "^7.3.11",
        "@mui/x-data-grid": "^8.28.7",
        "change-case": "^4.1.2",
        "commander": "^9.5.0",
        "glob": "^11.1.0",
        "graphql": "^16.14.2",
        "jiti": "^2.7.0",
        "object-path": "^0.11.8",
        "pluralize": "^8.0.0",
        "typescript": "5.9.3"
    },
    "devDependencies": {
        "@apollo/client": "^3.14.1",
        "@dextinity/eslint-config": "workspace:*",
        "@types/node": "^24.13.3",
        "@types/object-path": "^0.11.4",
        "@types/pluralize": "^0.0.33",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "final-form": "^4.20.10",
        "npm-run-all2": "^8.0.4",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-intl": "^7.1.11",
        "tsdown": "0.20.0-beta.4",
        "vitest": "^4.1.8"
    },
    "peerDependencies": {
        "@apollo/client": "^3.7.0",
        "final-form": "^4.0.0",
        "oxfmt": ">=0.63.0",
        "react-intl": "^5.0.0 || ^6.0.0 || ^7.0.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
