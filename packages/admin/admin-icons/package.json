{
    "name": "@dextinity/admin-icons",
    "version": "10.0.1",
    "description": "A collection of icons for Dextinity Admin",
    "license": "BSD-2-Clause",
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity",
        "directory": "packages/admin/admin-icons"
    },
    "files": [
        "lib"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./lib/index.js",
            "types": "./lib/index.d.ts"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "run-s clean generate-icons && run-p build:babel build:types",
        "build:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib",
        "build:types": "tsc --project ./tsconfig.json --emitDeclarationOnly",
        "clean": "rimraf lib",
        "generate-icons": "ts-node generate-icons.ts",
        "lint": "run-p lint:oxfmt lint:oxlint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:fix": "run-p lint:fix:oxlint lint:fix:oxfmt",
        "lint:fix:oxfmt": "pnpm exec oxfmt",
        "lint:fix:oxlint": "pnpm run lint:oxlint --fix",
        "lint:oxfmt": "pnpm exec oxfmt --check",
        "lint:oxlint": "oxlint --max-warnings 0 src/",
        "lint:tsc": "tsc --noEmit",
        "start": "pnpm run generate-icons && run-p start:babel start:types",
        "start:babel": "pnpm exec babel ./src -x \".ts,.tsx\" -d lib -w",
        "start:types": "tsc --project ./tsconfig.json --emitDeclarationOnly --watch --preserveWatchOutput"
    },
    "dependencies": {
        "use-constant": "^2.0.0",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@dextinity/admin-babel-preset": "workspace:*",
        "@dextinity/eslint-config": "workspace:*",
        "@mui/material": "^7.3.11",
        "@types/cli-progress": "^3.11.6",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "change-case": "^4.1.2",
        "cli-progress": "^3.12.0",
        "fast-xml-parser": "^5.8.0",
        "npm-run-all2": "^8.0.4",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "rimraf": "^6.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "@mui/material": "^7.0.0",
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
