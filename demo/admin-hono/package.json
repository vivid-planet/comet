{
    "name": "dextinity-demo-admin-hono",
    "private": true,
    "description": "Prototype: Dextinity Admin Demo for the Hono API (demo/api-hono)",
    "type": "module",
    "scripts": {
        "build": "NODE_ENV=production vite build",
        "lint": "run-p lint:prettier lint:eslint lint:tsc",
        "lint:ci": "pnpm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:eslint lint:fix:prettier",
        "lint:fix:eslint": "pnpm run lint:eslint --fix",
        "lint:fix:prettier": "pnpm run lint:prettier --write",
        "lint:prettier": "pnpm exec prettier --check '*.{ts,mts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --noEmit",
        "start": "dotenv -e ../../.env.local -e ../../.env -- vite"
    },
    "dependencies": {
        "@apollo/client": "^3.14.1",
        "@dextinity/admin": "workspace:*",
        "@dextinity/admin-icons": "workspace:*",
        "@dextinity/cms-admin-hono": "workspace:*",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/roboto-flex": "^5.3.0",
        "@mui/material": "^7.3.11",
        "@mui/x-data-grid": "^8.29.5",
        "@mui/x-date-pickers": "^8.29.5",
        "@tanstack/react-query": "^5.104.5",
        "final-form": "^4.20.10",
        "graphql": "^16.14.2",
        "history": "^4.10.1",
        "hono": "^4.13.13",
        "react": "^19.3.0",
        "react-dnd": "^16.0.1",
        "react-dom": "^19.3.0",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.14",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "workspace:*",
        "@swc/plugin-emotion": "^19.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-router": "^5.1.20",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.5",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "vite": "^8.3.5"
    }
}
