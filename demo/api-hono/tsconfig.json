{
    "compilerOptions": {
        "esModuleInterop": true,
        "lib": [
            "ES2023"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023",
        "types": [
            "node",
            "@cloudflare/workers-types"
        ],
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true
    },
    "include": [
        "src/**/*",
        "scripts/**/*"
    ]
}
