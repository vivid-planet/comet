# Copy to secrets.env and fill in. The shared values (database cluster, Spaces, imgproxy) are the Starter's DigitalOcean resources.
DEMO_CMS_APP_ID=
DEMO_SITE_APP_ID=

IDP_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 random bytes, e.g. `openssl rand -base64 32 | tr -- '+/' '-_'`
OAUTH2_PROXY_COOKIE_SECRET=

# The demo API expects the database password base64-encoded
POSTGRESQL_PWD_BASE64=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
IMGPROXY_KEY=
IMGPROXY_SALT=

# At least 16 characters each, e.g. `openssl rand -hex 16`
API_BASIC_AUTH_SYSTEM_USER_PASSWORD=
DAM_SECRET=
FILE_UPLOADS_DOWNLOAD_SECRET=
SITE_PREVIEW_SECRET=

# Required by the API; any value works as long as nobody uses the Brevo features on this deployment
BREVO_API_KEY=
BREVO_ECG_RTR_LIST_API_KEY=
BREVO_CAMPAIGN_BASIC_AUTH_PASSWORD=
