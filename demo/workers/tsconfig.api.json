{
    "compilerOptions": {
        "esModuleInterop": true,
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2023",
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
        "types": ["@cloudflare/workers-types"],
        "verbatimModuleSyntax": true
    },
    "include": ["api"]
}
